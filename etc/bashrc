# Source after OpenFOAM (v2412, the validated default; also v2106, v2212, v2306, v2406, v2506):
#   module load cae/openfoam+/v2412 && foamInit && source etc/bashrc
# Installs the cutCellIBM library and solvers into this project tree (one tree
# per OpenFOAM version: the build directories do not carry the version).
CUTCELL_IBM_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
export CUTCELL_IBM_DIR

case "$WM_PROJECT_VERSION" in
    v2106|v2212|v2306|v2406|v2412|v2506) ;;
    "") echo "Warning: OpenFOAM is not sourced" ;;
    *) echo "Warning: OpenFOAM $WM_PROJECT_VERSION is not among the tested versions (v2106 to v2506)" ;;
esac

export FOAM_USER_APPBIN=$CUTCELL_IBM_DIR/platforms/$WM_OPTIONS/bin
export FOAM_USER_LIBBIN=$CUTCELL_IBM_DIR/platforms/$WM_OPTIONS/lib
mkdir -p $FOAM_USER_APPBIN $FOAM_USER_LIBBIN
export PATH=$FOAM_USER_APPBIN:$PATH
export LD_LIBRARY_PATH=$FOAM_USER_LIBBIN:$LD_LIBRARY_PATH
