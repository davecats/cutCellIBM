FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }

solvers
{
    "T.*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0;
    }
    p
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-12;
        relTol          0.01;
    }
    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-12;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent      yes;
    pRefCell        0;
    pRefValue       0;
    residualControl
    {
        p               1e-9;
        U               1e-9;
        T               1e-8;
    }
}

relaxationFactors
{
    equations { U 0.9; T 1.0; }
    fields    { p 1.0; }
}
