FoamFile { version 2.0; format ascii; class dictionary; object blockMeshDict; }

// Uniform background mesh, h = 0.5 D; the adaptive refinement brings the
// cylinder to h = D/32 (maxLevel 4)
x0 -5; x1 15; y0 -6; y1 6; nx 40; ny 24; dz 0.5;

vertices
(
    ($x0 $y0 0)   ($x1 $y0 0)   ($x1 $y1 0)   ($x0 $y1 0)
    ($x0 $y0 $dz) ($x1 $y0 $dz) ($x1 $y1 $dz) ($x0 $y1 $dz)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny 1) simpleGrading (1 1 1)
);

boundary
(
    inlet  { type patch; faces ((0 4 7 3)); }
    outlet { type patch; faces ((1 2 6 5)); }
    sides  { type patch; faces ((0 1 5 4) (3 7 6 2)); }
    frontAndBack { type empty; faces ((0 3 2 1) (4 5 6 7)); }
);
