FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }

solvers
{
    p
    {
        // CG preconditioned by GAMG: the linked cut cells need the incomplete-Cholesky
        // smoother, and GAMG as the solver takes 85 instead of 7 iterations per solve;
        // linkedGroup for linked groups split over processors (README section 4)
        solver          PCG;
        preconditioner
        {
            preconditioner  linkedGroup;
            base            { preconditioner GAMG; smoother DICGaussSeidel; }
        }
        tolerance       1e-8;
        relTol          0.01;
    }
    pFinal { $p; relTol 0; }
    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-9;
        relTol          0;
    }
    UFinal { $U; }
}

PIMPLE
{
    momentumPredictor   yes;
    nOuterCorrectors    3;      // one PISO pass is first order in time (C_L amplitude +13 % in DFG 2D-2)
    nCorrectors         2;
    nNonOrthogonalCorrectors 0;
    consistent          no;
    ddtCorr             yes;
}
